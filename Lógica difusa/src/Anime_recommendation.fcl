FUNCTION_BLOCK AnimeRecommendation

VAR_INPUT
    accion : REAL;
    romance : REAL;
    comedia : REAL;
    drama : REAL;
    fantasia : REAL;
    ciencia_ficcion : REAL;
    terror : REAL;
END_VAR

VAR_OUTPUT
    recomendacion : REAL;
END_VAR

// Definición de niveles difusos para cada género
FUZZIFY accion
    TERM leve := (0,1) (3,1) (6,0);
    TERM moderado := (3,0) (5,1) (7,0);
    TERM intenso := (6,0) (8,1) (10,1);
END_FUZZIFY

FUZZIFY romance
    TERM nulo := (0,1) (3,1) (6,0);
    TERM suave := (3,0) (5,1) (7,0);
    TERM marcado := (6,0) (8,1) (10,1);
END_FUZZIFY

FUZZIFY comedia
    TERM escasa := (0,1) (3,1) (6,0);
    TERM regular := (3,0) (5,1) (7,0);
    TERM abundante := (6,0) (8,1) (10,1);
END_FUZZIFY

FUZZIFY drama
    TERM reducido := (0,1) (3,1) (6,0);
    TERM notable := (3,0) (5,1) (7,0);
    TERM elevado := (6,0) (8,1) (10,1);
END_FUZZIFY

FUZZIFY fantasia
    TERM inexistente := (0,1) (3,1) (6,0);
    TERM presente := (3,0) (5,1) (7,0);
    TERM dominante := (6,0) (8,1) (10,1);
END_FUZZIFY

FUZZIFY ciencia_ficcion
    TERM poca := (0,1) (3,1) (6,0);
    TERM media := (3,0) (5,1) (7,0);
    TERM fuerte := (6,0) (8,1) (10,1);
END_FUZZIFY

FUZZIFY terror
    TERM ligera := (0,1) (3,1) (6,0);
    TERM moderada := (3,0) (5,1) (7,0);
    TERM intensa := (6,0) (8,1) (10,1);
END_FUZZIFY

// Evaluación difusa del índice de recomendación
DEFUZZIFY recomendacion
    TERM baja := (0,1) (20,1) (40,0);
    TERM media := (30,0) (50,1) (70,0);
    TERM alta := (60,0) (80,1) (100,1);
    METHOD : COG;
END_DEFUZZIFY

// Reglas para inferencia difusa
RULEBLOCK LogicaDifusa
    RULE 1: IF terror IS intensa AND drama IS notable THEN recomendacion IS media;
    RULE 2: IF romance IS marcado AND comedia IS regular AND drama IS elevado THEN recomendacion IS alta;
    RULE 3: IF comedia IS escasa AND romance IS nulo AND accion IS leve THEN recomendacion IS baja;
    RULE 4: IF accion IS intenso AND fantasia IS dominante AND ciencia_ficcion IS media THEN recomendacion IS alta;
    RULE 5: IF ciencia_ficcion IS fuerte AND accion IS intenso AND comedia IS escasa THEN recomendacion IS alta;
    RULE 6: IF comedia IS abundante AND romance IS suave THEN recomendacion IS media;
    RULE 7: IF accion IS leve AND drama IS elevado AND romance IS marcado THEN recomendacion IS media;
    RULE 8: IF terror IS intensa AND accion IS moderado AND fantasia IS inexistente THEN recomendacion IS media;
    RULE 9: IF fantasia IS presente AND romance IS marcado AND comedia IS regular THEN recomendacion IS media;
    RULE 10: IF accion IS moderado AND ciencia_ficcion IS fuerte AND fantasia IS presente THEN recomendacion IS alta;
END_RULEBLOCK

END_FUNCTION_BLOCK
