package Puzzle;

public class Nodo {

    public Nodo padre;
    public int[][] estado;
    public int fila, columna;
    public int costo;
    public int nivel;

    public Nodo(int[][] origen, int filaOrigen, int colOrigen, int filaDestino, int colDestino, int nivel, Nodo padre)
    {
    	this.padre = padre;
        this.estado = copiarMatriz(origen);

        intercambiar(estado, filaOrigen, colOrigen, filaDestino, colDestino);

        this.costo = Integer.MAX_VALUE;
        this.nivel = nivel;
        this.fila = filaDestino;
        this.columna = colDestino;
    }

    private int[][] copiarMatriz(int[][] matrizOriginal) 
    {
        int[][] copia = new int[matrizOriginal.length][];
        for (int i = 0; i < matrizOriginal.length; i++) {
            copia[i] = matrizOriginal[i].clone();
        }
        return copia;
    }

    private void intercambiar(int[][] matriz, int x1, int y1, int x2, int y2) 
    {
        int temporal = matriz[x1][y1];
        matriz[x1][y1] = matriz[x2][y2];
        matriz[x2][y2] = temporal;
    }
}
